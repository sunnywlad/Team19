# Variables lues par relay/. Aucune valeur ici : copier les noms dans .env.
# Les deux clés ne sont jamais écrites dans le dépôt ni dans les journaux.

# Chaîne et contrat
RPC_URL=
CHAIN_ID=
VAULT_ADDRESS=
CLIENT_ID=

# Clé du client : signe les demandes (bouchon de l'IA du client).
CLIENT_SIGNER=
# Clé du relais : ne porte que du gaz, soumet les demandes signées.
RELAYER=

# Bases SQLite locales
QUEUE_DB=
INDEX_DB=

# Service de journal de response/ (http://127.0.0.1:8790). Absente : bouchon en mémoire.
JOURNAL_URL=
# Boîte d'envoi du journal (SQLite) : entrées en attente de remise, avec leur clé
# d'idempotence. Défaut : var/journal-outbox.db. La même pour npm start et start:client-ia.
JOURNAL_OUTBOX_DB=

# Liste des pauses hors chaîne du service de réponse : GET <url>/agents/paused
# (http://127.0.0.1:8790). Posée, elle devient obligatoire : sans réponse, rien
# n'est soumis. Absente : bouchon, liste vide, seule la pause sur la chaîne compte.
PAUSE_SOURCE_URL=

# Service « IA du client » (npm run start:client-ia), sur 127.0.0.1. Défaut : 8770.
# La porte d'entrée y transmet avec CLIENT_AI_URL=http://127.0.0.1:8770/accepted
CLIENT_IA_PORT=

# Indexeur et API en lecture seule (127.0.0.1)
START_BLOCK=
CONFIRMATIONS=
API_PORT=
POLL_INTERVAL_MS=

# Coffre : « chain » (défaut, contrat par RPC_URL et VAULT_ADDRESS) ou « fake »
# (faux coffre en mémoire, monde de specs/examples/fixtures.json, aucun fonds,
# aucune chaîne). En mode fake, CLIENT_SIGNER et VAULT_ADDRESS restent lues :
# le faux coffre vérifie les signatures du service « IA du client ».
VAULT_MODE=
# 1 avec VAULT_MODE=fake : ouvre le port de contrôle de démo (approve, refuse,
# expire du faux coffre, à la place de l'approbateur). Sinon il n'existe pas.
DEMO_MODE=
# Port de contrôle de démo, sur 127.0.0.1. Défaut : 8788.
DEMO_CONTROL_PORT=
