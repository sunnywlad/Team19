{
  "name": "argent-intelligent-relay",
  "version": "0.1.0",
  "private": true,
  "description": "Agents scriptés, signature du client, file, relais et indexeur. Aucune action ne déplace de fonds hors du contrat.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test --disable-warning=ExperimentalWarning \"test/**/*.test.ts\"",
    "test:anvil": "node --test --disable-warning=ExperimentalWarning test/anvil.test.ts",
    "typecheck": "tsc --noEmit",
    "start": "node --disable-warning=ExperimentalWarning src/main.ts",
    "scene": "node --disable-warning=ExperimentalWarning src/scene-cli.ts"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "viem": "2.57.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  }
}
