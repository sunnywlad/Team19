{
  "name": "argent-intelligent-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Porte d'entrée : jeton d'agent, limite de débit, détecteur à trois signaux, schéma strict. Elle ne paie rien et ne transmet que des identifiants.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test --disable-warning=ExperimentalWarning \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "start": "node --disable-warning=ExperimentalWarning src/main.ts",
    "bench": "node --disable-warning=ExperimentalWarning src/bench.ts"
  },
  "dependencies": {
    "ajv": "8.20.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  }
}
