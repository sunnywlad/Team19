# Variables lues par gateway/. Aucune n'est un secret. Les valeurs ci-dessous
# sont les valeurs par défaut, sauf CLIENT_AI_URL.
# Copier en .env pour les changer. Ne jamais commiter .env.

# Port d'écoute, sur 127.0.0.1 seulement.
GATEWAY_PORT=8780
# Service de journal (response/). Sans réponse de sa part, la porte refuse tout.
JOURNAL_URL=http://127.0.0.1:8790
# Étape 4 : où transmettre une demande acceptée. Vide : arrêt après l'étape 3.
CLIENT_AI_URL=http://127.0.0.1:8770/accepted
# Agents à enrôler, avec leur mandat.
GATEWAY_AGENTS_FILE=../specs/examples/fixtures.json
# Jetons émis, quarantaine, sorties. Jamais versionné.
GATEWAY_DATA_DIR=var
# Durée de vie d'un jeton d'agent, en secondes.
AGENT_TOKEN_TTL_SECONDS=900
# 1 pour ouvrir POST /demo/reissue-tokens. Vide en dehors d'une démo.
DEMO_MODE=
