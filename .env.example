# Copier ce fichier en .env et remplir avec des clés de TEST uniquement.
# Aucune valeur ici : ce fichier ne liste que des noms. Ne jamais commiter .env.
# Une clé par rôle, aucune clé partagée. Chaque service ne lit que la sienne.
# Aucune de ces clés ne doit servir sur un réseau réel.
#
# Liste unique des noms, tels que le code les lit. Chaque dossier garde son
# propre .env.example ou son README pour le détail et les valeurs par défaut.

# --- Chaîne (relay/, offchain/) ---
RPC_URL=
CHAIN_ID=

# --- relay/ : coffre, file, relais, indexeur, API en lecture (127.0.0.1:8787) ---
VAULT_ADDRESS=
CLIENT_ID=
# SECRET. Clé du client : signe les demandes (bouchon de l'IA du client).
CLIENT_SIGNER=
# SECRET. Clé du relais : ne porte que du gaz, soumet les demandes signées.
RELAYER=
QUEUE_DB=
INDEX_DB=
START_BLOCK=
CONFIRMATIONS=
API_PORT=
POLL_INTERVAL_MS=

# --- Journal : lu par relay/ et gateway/, servi par response/ ---
# http://127.0.0.1:8790. Sans elle, relay/ garde un journal en mémoire.
JOURNAL_URL=

# --- response/ : journal chaîné, réactions, rapports (127.0.0.1:8790) ---
JOURNAL_FILE=
JOURNAL_PORT=
RESPONSE_AGENTS_FILE=
RESPONSE_DATA_DIR=
QUARANTINE_DIR=
# Lue par les commandes human et demo:reset (défaut http://127.0.0.1:8780).
GATEWAY_URL=

# --- gateway/ : porte d'entrée (127.0.0.1:8780) ---
# Attention : offchain/gateway lit aussi GATEWAY_PORT (défaut 8700). « make demo »
# ne lit aucun port ici : ses ports sont fixes (demo/lib.mjs, PORTS).
GATEWAY_PORT=
GATEWAY_AGENTS_FILE=
GATEWAY_DATA_DIR=
# http://127.0.0.1:8770/accepted : le bouchon de l'IA du client.
CLIENT_AI_URL=
# Durée de vie d'un jeton d'agent, en secondes (défaut 900).
AGENT_TOKEN_TTL_SECONDS=

# --- Démo : lue par gateway/, response/ et relay/ ---
# 1 pour ouvrir les routes de remise à zéro (archive du journal, jetons réémis)
# et, dans relay/ avec VAULT_MODE=fake, le port de contrôle du faux coffre.
# Vide en dehors d'une démo : ces routes n'existent alors pas.
DEMO_MODE=
# relay/ et demo/ : « fake » (défaut de make demo : faux coffre en mémoire,
# aucun fonds, aucune chaîne) ou « chain » (contrat déployé). Absente dans
# relay/ : chain.
VAULT_MODE=
# relay/ : port de contrôle du faux coffre (127.0.0.1, défaut 8788). Attention :
# 8788 est aussi le défaut de FIXTURES_API_URL du dashboard.
DEMO_CONTROL_PORT=

# --- dashboard/ : lues par le proxy local seulement, jamais dans le bundle ---
DASHBOARD_MODE=
# Lue aussi par response/ (défaut http://127.0.0.1:8787).
RELAY_API_URL=
RELAY_HAS_VAULT=
# « fake » ou « chain » : ce que le relais a derrière lui (voir VAULT_MODE).
RELAY_VAULT_MODE=
RESPONSE_API_URL=
# SECRET éventuel, ajouté côté serveur par le proxy.
RESPONSE_API_TOKEN=
FIXTURES_API_URL=
FIXTURES_PORT=

# --- offchain/ : marché de vérification (passerelle 8700, cache 8701) ---
MARKET_ADDRESS=
CACHE_URL=
CACHE_PORT=
CACHE_DATA_DIR=
# SECRET. Jeton d'écriture du cache.
CACHE_WRITE_TOKEN=
SECURITY_ADDRESSES=
# SECRET. Clés d'API de la passerelle, séparées par des virgules.
GATEWAY_API_KEYS=
# SECRET. Clé du demandeur (démo).
REQUESTER_KEY=
# SECRET. Clé d'un vérificateur, une par instance.
VERIFIER_KEY=
VERIFIER_DATA_DIR=
EVALUATOR_CMD=
EVALUATOR_TIMEOUT_MS=
INCIDENTS_LOG=
POLL_MS=
# Outils Foundry pour les tests, pris dans le PATH par défaut.
FORGE=
ANVIL=
CAST=

# --- script/ : paramètres de déploiement des contrats (forge script) ---
FEE=
COMMIT_WINDOW=
REVEAL_WINDOW=
CONTEST_WINDOW=
COMMITTEE_0=
COMMITTEE_1=
COMMITTEE_2=
CANDIDATE_1=
CANDIDATE_2=
CANDIDATE_3=
CANDIDATE_4=
MIN_STAKE=
LOCK_BPS=
STRIKE_LIMIT=
EXCLUSION_REQUESTS=
BONUS=
REGISTRY=
SLASHING=
REWARDS=

# --- Réservés : prévus par specs/, lus par aucun code aujourd'hui ---
# SECRETS. Rôles du coffre de specs/02 (propriétaire, admission, approbateur,
# gardien), à brancher quand le contrat ArgentVault existera.
OWNER_PRIVATE_KEY=
ADMISSION_PRIVATE_KEY=
APPROVER_PRIVATE_KEY=
GUARDIAN_PRIVATE_KEY=
# Mode LLM optionnel.
LLM_API_KEY=

# --- relay/ : boîte d'envoi du journal et pauses hors chaîne ---
# relay/ seulement : boîte d'envoi du journal (SQLite), entrées en attente de
# remise avec leur clé d'idempotence. Défaut : var/journal-outbox.db.
JOURNAL_OUTBOX_DB=

# Pauses hors chaîne : lue par relay/, servie par response/.
# http://127.0.0.1:8790 (GET /agents/paused). Posée, elle devient obligatoire :
# sans réponse, le relais ne soumet rien. Absente : liste vide, seule la pause
# sur la chaîne compte.
PAUSE_SOURCE_URL=

# relay/ : service « IA du client » (npm run start:client-ia, 127.0.0.1).
# Défaut : 8770. Signe avec CLIENT_SIGNER et dépose dans QUEUE_DB.
CLIENT_IA_PORT=
