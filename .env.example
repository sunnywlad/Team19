# Copier ce fichier en .env et remplir avec des clés de TEST uniquement.
# Aucune valeur ici : ce fichier ne liste que des noms. Ne jamais commiter .env.
# Une clé par rôle, aucune clé partagée. Chaque service ne lit que la sienne.
# Aucune de ces clés ne doit servir sur un réseau réel.
#
# Liste unique des noms, tels que le code les lit. Chaque dossier garde son
# propre .env.example ou son README pour le détail et les valeurs par défaut.

# --- Chaîne (relay/, offchain/) ---
RPC_URL=
CHAIN_ID=

# --- relay/ : coffre, file, relais, indexeur, API en lecture (127.0.0.1:8787) ---
VAULT_ADDRESS=
CLIENT_ID=
# SECRET. Clé du client : signe les demandes (bouchon de l'IA du client).
CLIENT_SIGNER=
# SECRET. Clé du relais : ne porte que du gaz, soumet les demandes signées.
RELAYER=
QUEUE_DB=
INDEX_DB=
START_BLOCK=
CONFIRMATIONS=
API_PORT=
POLL_INTERVAL_MS=

# --- Journal : lu par relay/ et gateway/, servi par response/ ---
# http://127.0.0.1:8790. Sans elle, relay/ garde un journal en mémoire.
JOURNAL_URL=

# --- response/ : journal chaîné, réactions, rapports (127.0.0.1:8790) ---
JOURNAL_FILE=
JOURNAL_PORT=
RESPONSE_AGENTS_FILE=
RESPONSE_DATA_DIR=
QUARANTINE_DIR=

# --- gateway/ : porte d'entrée (127.0.0.1:8780) ---
# Attention : offchain/gateway lit aussi GATEWAY_PORT (défaut 8700).
GATEWAY_PORT=
GATEWAY_AGENTS_FILE=
GATEWAY_DATA_DIR=
CLIENT_AI_URL=

# --- dashboard/ : lues par le proxy local seulement, jamais dans le bundle ---
DASHBOARD_MODE=
# Lue aussi par response/ (défaut http://127.0.0.1:8787).
RELAY_API_URL=
RELAY_HAS_VAULT=
RESPONSE_API_URL=
# SECRET éventuel, ajouté côté serveur par le proxy.
RESPONSE_API_TOKEN=
FIXTURES_API_URL=
FIXTURES_PORT=

# --- offchain/ : marché de vérification (passerelle 8700, cache 8701) ---
MARKET_ADDRESS=
CACHE_URL=
CACHE_PORT=
CACHE_DATA_DIR=
# SECRET. Jeton d'écriture du cache.
CACHE_WRITE_TOKEN=
SECURITY_ADDRESSES=
# SECRET. Clés d'API de la passerelle, séparées par des virgules.
GATEWAY_API_KEYS=
# SECRET. Clé du demandeur (démo).
REQUESTER_KEY=
# SECRET. Clé d'un vérificateur, une par instance.
VERIFIER_KEY=
VERIFIER_DATA_DIR=
EVALUATOR_CMD=
EVALUATOR_TIMEOUT_MS=
INCIDENTS_LOG=
POLL_MS=
# Outils Foundry pour les tests, pris dans le PATH par défaut.
FORGE=
ANVIL=
CAST=

# --- script/ : paramètres de déploiement des contrats (forge script) ---
FEE=
COMMIT_WINDOW=
REVEAL_WINDOW=
CONTEST_WINDOW=
COMMITTEE_0=
COMMITTEE_1=
COMMITTEE_2=
CANDIDATE_1=
CANDIDATE_2=
CANDIDATE_3=
CANDIDATE_4=
MIN_STAKE=
LOCK_BPS=
STRIKE_LIMIT=
EXCLUSION_REQUESTS=
BONUS=
REGISTRY=
SLASHING=
REWARDS=

# --- Réservés : prévus par specs/, lus par aucun code aujourd'hui ---
# SECRETS. Rôles du coffre de specs/02 (propriétaire, admission, approbateur,
# gardien), à brancher quand le contrat ArgentVault existera.
OWNER_PRIVATE_KEY=
ADMISSION_PRIVATE_KEY=
APPROVER_PRIVATE_KEY=
GUARDIAN_PRIVATE_KEY=
# Clé de pseudonymisation des identifiants, 32 caractères aléatoires au moins.
PSEUDONYM_KEY=
# Mode LLM optionnel.
LLM_API_KEY=
