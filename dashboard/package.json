{
  "name": "argent-intelligent-dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "Dashboard en lecture seule : décisions du contrat, motif, réponse déclenchée, délais mesurés. N'émet que des GET.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "gen": "node tools/gen-validators.mjs",
    "dev": "npm run --silent gen && vite",
    "dev:sim": "npm run --silent gen && DASHBOARD_MODE=simulation vite",
    "dev:fixtures": "node --disable-warning=ExperimentalWarning fixtures/server.ts",
    "build": "npm run --silent gen && vite build",
    "preview": "vite preview",
    "lint": "node tools/lint.mjs",
    "typecheck": "npm run --silent gen && tsc --noEmit",
    "test": "npm run --silent gen && vitest run"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "ajv": "8.20.0",
    "jsdom": "29.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
