{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:argent-intelligent:dashboard:response-incidents:1",
  "title": "PROPOSÉ (API-NEEDS.md) : GET /incidents, rapports de specs/05 et extrait mis en quarantaine",
  "type": "array",
  "maxItems": 200,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["report", "quarantine_excerpt"],
    "properties": {
      "report": { "$ref": "urn:argent-intelligent:schema:incident-report:1" },
      "quarantine_excerpt": {
        "description": "Extrait du document en quarantaine. Contenu hostile : jamais interprété.",
        "oneOf": [{ "type": "string", "maxLength": 4000 }, { "type": "null" }]
      }
    }
  }
}
