{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:argent-intelligent:dashboard:defs:1",
  "title": "Types communs aux formes lues par le dashboard",
  "$defs": {
    "hex32": { "type": "string", "pattern": "^0x[0-9a-f]{64}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "wei": { "type": "string", "pattern": "^(0|[1-9][0-9]{0,77})$" },
    "weiOrNull": { "oneOf": [{ "$ref": "#/$defs/wei" }, { "type": "null" }] },
    "uint": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "blockTimestamp": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
    "unixMillis": { "type": "integer", "minimum": 1, "maximum": 4294967295999 }
  }
}
