# Variables lues par vite.config.ts, CÔTÉ SERVEUR uniquement (proxy local).
# Rien ici n'entre dans le bundle : le navigateur n'appelle que /api/* sur sa
# propre origine. Aucune valeur dans ce fichier : copier les noms dans .env.

# « simulation » : tout vient du serveur de fixtures. Vide : relais réel.
DASHBOARD_MODE=

# API en lecture seule du relais (défaut : http://127.0.0.1:8787).
RELAY_API_URL=
# Mettre à 1 quand le relais sert GET /vault (voir API-NEEDS.md).
RELAY_HAS_VAULT=
# Ce que le relais a derrière lui : « chain » (contrat) ou « fake » (faux coffre
# en mémoire, VAULT_MODE=fake). Servi à la page par le proxy (/api/local/mode),
# jamais écrit dans le bundle. « fake » : bandeau « COFFRE SIMULÉ » et étiquette
# « simulation ». Vide : « origine non confirmée », jamais « réel » par défaut.
RELAY_VAULT_MODE=

# Service de réponse (incidents, journal, pauses). Vide : simulation.
RESPONSE_API_URL=
# Jeton éventuel du service de réponse : ajouté par le proxy, jamais envoyé au navigateur.
RESPONSE_API_TOKEN=

# Serveur de fixtures (défaut : http://127.0.0.1:8788) et son port d'écoute.
FIXTURES_API_URL=
FIXTURES_PORT=

# Référentiel de libellés (identifiant opaque → libellé d'affichage), servi par
# le proxy (/api/local/libelles). Défaut : fixtures/libelles.json, synthétique.
# Jamais transmis au relais ni écrit sur la chaîne.
LIBELLES_FILE=
# Unité d'affichage des montants, servie par le proxy (/api/local/unite) :
# 1 UNITE_SYMBOLE = 10^UNITE_DECIMALES wei. Défaut : « u » et 15, jamais « € ».
UNITE_SYMBOLE=
UNITE_DECIMALES=
