# Variables lues par response/. Aucune n'est un secret : ce service ne tient
# aucune clé. Les valeurs ci-dessous sont les valeurs par défaut.
# Copier en .env pour les changer. Ne jamais commiter .env.

# Fichier du journal chaîné, une entrée JSON par ligne.
JOURNAL_FILE=var/journal.jsonl
# Port d'écoute, sur 127.0.0.1 seulement.
JOURNAL_PORT=8790
# API en lecture du relais : décisions du contrat et file.
RELAY_API_URL=http://127.0.0.1:8787
# Agents et mandats, pour la chaîne d'autorité des rapports.
RESPONSE_AGENTS_FILE=../specs/examples/fixtures.json
# Documents gelés par la porte d'entrée, lus pour l'extrait.
QUARANTINE_DIR=../gateway/var/quarantine
# Rapports d'incident, dans incidents/.
RESPONSE_DATA_DIR=var
# 1 pour ouvrir POST /demo/reset (archive le journal, chaîne neuve). Vide en dehors d'une démo.
DEMO_MODE=

# Lues par les commandes « human » et « demo:reset ».
JOURNAL_URL=http://127.0.0.1:8790
GATEWAY_URL=http://127.0.0.1:8780
