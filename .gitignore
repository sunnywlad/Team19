# --- Secrets : ne jamais retirer d'entrée de ce bloc ---
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.keystore
keystore/
broadcast/

# --- Données locales de la démo (make demo) : clé générée, pid, logs, bases ---
/var/

