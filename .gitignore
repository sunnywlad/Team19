.tools/
# --- Dépendances installées ---
node_modules/
# Sorties du compilateur Foundry, à la racine seulement : un « cache/ » non
# ancré ignorait aussi offchain/cache/, le code du service de cache.
/cache/
/out/
# Commonly ignored directories
.logs/
.ignore/
